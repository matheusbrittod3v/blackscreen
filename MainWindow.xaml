<Window x:Class="Black.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Black"
        Title="BlackScreenTool Controller"
        Height="460"
        Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        Foreground="White">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="413*"/>
            <ColumnDefinition Width="323*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <TextBlock Text="Controle de area de trabalho Virtuais"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="6,6,6,6" Grid.ColumnSpan="2"/>

        <!-- Área principal -->
        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Background="#222"
                CornerRadius="6"
                Padding="12" Grid.ColumnSpan="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Lista de Monitores -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Monitores detectados:"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ScreensList" Width="470">
                            <!-- Itens adicionados dinamicamente via C# -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="6">
                                        <CheckBox Width="20" Tag="{Binding}" />
                                        <TextBlock Text="{Binding DeviceName}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Painel de Ações -->
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top">
                    <Button x:Name="BtnInstall"
                            Content="Iniciar"
                            Margin="0,6"
                            Height="36"
                            Click="BtnInstall_Click"/>
                    <Button x:Name="BtnRemove"
                            Content="Remover"
                            Margin="0,6"
                            Height="36"
                            Click="BtnRemove_Click"/>
                    <Button x:Name="BtnDisplay"
                            Content="Abrir Configurações de Exibição"
                            Margin="0,6"
                            Height="36"
                            Click="BtnDisplay_Click"/>
                    <Button x:Name="BtnActivate"
                            Content="Ativar BlackScreen"
                            Margin="0,18,0,6"
                            Height="40"
                            Click="BtnActivate_Click"/>
                    <Button x:Name="BtnCloseAll"
                            Content="Fechar todas BlackScreens"
                            Margin="0,6"
                            Height="36"
                            Click="BtnCloseAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rodapé -->
        <TextBlock Grid.Row="2"
                   Text="-Desenvolvido por @Matheus.britto.dev-"
                   FontSize="12"
                   Foreground="#ccc"
                   HorizontalAlignment="Left"
                   Margin="278,6,0,6" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
